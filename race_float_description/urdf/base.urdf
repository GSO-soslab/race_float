    <!--
        AprilTag links.
        Convention: <prefix><family>_<id>, where <family> is the pupil_apriltags
        family name without the "tag" prefix (e.g. "25h9", "36h11"). The numeric
        id is per-family: two tags in different families may share the same id.

        All origins are temporarily zeroed out; real physical layout TBD.
    -->

    <!-- 4 x tag25h9 (21 cm) -->
    <link name="apriltag25h9_17"/>
    <joint name="apriltag25h9_17_joint" type="fixed">
        <!-- <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/> -->
        <origin xyz="-1.22 0.33 0.17" rpy="0.0 1.5707963 3.1415926"/>
        <parent link="base_link"/>
        <child link="apriltag25h9_17"/>
