<?xml version="1.0"?>

<robot name="race_station">
   <link name="nose_tip_link">
   <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <!-- <visual>
            <origin xyz="00.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://race_station_description/mesh/RACE_body.stl" scale="0.001 0.001 0.001"/>
            </geometry>
